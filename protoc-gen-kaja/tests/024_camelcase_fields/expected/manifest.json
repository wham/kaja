        {
          "name": "CamelCaseEdgeCases",
          "text": "/** Test edge cases in camelCase conversion */\nexport interface CamelCaseEdgeCases {\n    /** Numbers after underscore Should be field1value */\n    field1Value: string;\n    /** Should be field2Value */\n    field2Value: string;\n    /** Multiple consecutive underscores */\n    fieldName: string;\n    /** Leading/trailing underscores */\n    Private: string;\n    trailing: string;\n    /** All caps with underscores */\n    hTTPURL: string;\n    aPIKEY: string;\n    /** Mixed case combinations */\n    getHTTPResponseCode: string;\n    uRLPath: string;\n    xmlHTTPRequest: string;\n    /** Single character segments */\n    aBC: string;\n    x1Y2Z3: string;\n}",
          "references": []
        },
