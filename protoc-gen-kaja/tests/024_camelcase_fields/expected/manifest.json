          "name": "CamelCaseFields",
          "text": "/** Test fields that are already camelCase */\nexport interface CamelCaseFields {\n    firstName: string;\n    lastName: string;\n    emailAddress: string;\n    userId: number;\n    isActive: boolean;\n    fullName: string;\n}",
