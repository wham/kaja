        {
          "name": "MultipleOneofs",
          "text": "/** Test message with multiple oneof groups */\nexport interface MultipleOneofs {\n    id: string;\n    authentication: {\n        oneofKind: \"password\";\n        password: string;\n    } | {\n        oneofKind: \"token\";\n        token: string;\n    } | {\n        oneofKind: \"apiKey\";\n        apiKey: string;\n    } | {\n        oneofKind: undefined;\n    };\n    dataFormat: {\n        oneofKind: \"json\";\n        json: string;\n    } | {\n        oneofKind: \"xml\";\n        xml: string;\n    } | {\n        oneofKind: \"binary\";\n        binary: Uint8Array;\n    } | {\n        oneofKind: undefined;\n    };\n    status: {\n        oneofKind: \"active\";\n        active: boolean;\n    } | {\n        oneofKind: \"inactive\";\n        inactive: boolean;\n    } | {\n        oneofKind: \"pending\";\n        pending: boolean;\n    } | {\n        oneofKind: undefined;\n    };\n    name: string;\n    metadata: {\n        oneofKind: \"description\";\n        description: string;\n    } | {\n        oneofKind: \"version\";\n        version: number;\n    } | {\n        oneofKind: undefined;\n    };\n}",
          "references": []
        },
        {
          "name": "Container",
