        {
          "name": "OneofAllTypes",
          "text": "/** Test oneof with all scalar types */\nexport interface OneofAllTypes {\n    value: {\n        oneofKind: \"doubleVal\";\n        doubleVal: number;\n    } | {\n        oneofKind: \"floatVal\";\n        floatVal: number;\n    } | {\n        oneofKind: \"int32Val\";\n        int32Val: number;\n    } | {\n        oneofKind: \"int64Val\";\n        int64Val: string;\n    } | {\n        oneofKind: \"uint32Val\";\n        uint32Val: number;\n    } | {\n        oneofKind: \"uint64Val\";\n        uint64Val: string;\n    } | {\n        oneofKind: \"sint32Val\";\n        sint32Val: number;\n    } | {\n        oneofKind: \"sint64Val\";\n        sint64Val: string;\n    } | {\n        oneofKind: \"fixed32Val\";\n        fixed32Val: number;\n    } | {\n        oneofKind: \"fixed64Val\";\n        fixed64Val: string;\n    } | {\n        oneofKind: \"sfixed32Val\";\n        sfixed32Val: number;\n    } | {\n        oneofKind: \"sfixed64Val\";\n        sfixed64Val: string;\n    } | {\n        oneofKind: \"boolVal\";\n        boolVal: boolean;\n    } | {\n        oneofKind: \"stringVal\";\n        stringVal: string;\n    } | {\n        oneofKind: \"bytesVal\";\n        bytesVal: Uint8Array;\n    } | {\n        oneofKind: undefined;\n    };\n}",
