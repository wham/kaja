          "text": "/** Optional with oneof (edge case) */\nexport interface OptionalWithOneof {\n    optionalField?: string;\n    choice: {\n        oneofKind: \"text\";\n        text: string;\n    } | {\n        oneofKind: \"number\";\n        number: number;\n    } | {\n        oneofKind: undefined;\n    };\n    anotherOptional?: number;\n}",
          "references": []
