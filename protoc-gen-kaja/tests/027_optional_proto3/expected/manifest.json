        {
          "name": "OptionalFields",
          "text": "/** Test proto3 optional fields (proto3.15+ feature) */\nexport interface OptionalFields {\n    /** Regular required fields (proto3 default) */\n    requiredString: string;\n    requiredInt: number;\n    /** Optional scalar fields */\n    optionalString?: string;\n    optionalInt?: number;\n    optionalBool?: boolean;\n    optionalDouble?: number;\n    /** Optional message field */\n    optionalMessage?: Nested;\n    /** Optional enum field */\n    optionalEnum?: Status;\n    /** Mix of optional and required */\n    required2: string;\n    optional2?: string;\n    required3: number;\n    optional3?: number;\n}",
          "references": [
            "Nested",
            "Status"
          ]
        },
        {
          "name": "Nested",
          "text": "export interface Nested {\n    value: string;\n}",
          "references": []
        },
        {
          "name": "AllOptional",
          "text": "/** All optional fields */\nexport interface AllOptional {\n    field1?: string;\n    field2?: number;\n    field3?: boolean;\n    field4?: Uint8Array;\n    field5?: Nested;\n}",
          "references": [
            "Nested"
          ]
        },
        {
          "name": "Container",
          "text": "/** Optional in nested message */\nexport interface Container {\n    inner?: Container_Inner;\n    optionalName?: string;\n}",
          "references": [
            "Container_Inner"
