          "text": "export interface FieldComments {\n    /** Leading comment for field1 */\n    field1: string;\n    /** Trailing comment for field2 */\n    field2: string;\n    /** * JSDoc style comment @param {string} value - The value @returns {boolean} Success */\n    field3: string;\n    /** Comment with special characters: @#$%^\u0026*() */\n    field4: string;\n    /** Comment with \"quotes\" and 'apostrophes' */\n    field5: string;\n    /** Comment with backslashes \\ and forward slashes / */\n    field6: string;\n    /** C-style comment */\n    field7: string;\n    /** Multi-line C-style with asterisks */\n    field8: string;\n    /** TODO: implement this field */\n    field9: string;\n    /** FIXME: this needs review */\n    field10: string;\n    /** Comment with code: `someCode()` */\n    field11: string;\n    /** Comment with markdown **bold** and *italic* */\n    field12: string;\n    /** Comment with emoji 🚀 ✨ 🎉 */\n    field13: string;\n    /** Comment with URL: https://example.com */\n    field14: string;\n    /** Comment with XML: \u003ctag\u003econtent\u003c/tag\u003e */\n    field15: string;\n    field16: string;\n}",
