#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT_DIR="$(cd "$PROJECT_DIR/.." && pwd)"
TESTS_DIR="$PROJECT_DIR/tests"
RESULTS_DIR="$PROJECT_DIR/results"

SERVER_BUILD_DIR="$ROOT_DIR/server/build"
PROTOC_GEN_TS="$PROJECT_DIR/node_modules/.bin/protoc-gen-ts"
PROTOC_GEN_KAJA="$SERVER_BUILD_DIR/protoc-gen-kaja"
TSC="$ROOT_DIR/ui/node_modules/.bin/tsc"

SUMMARY_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --summary) SUMMARY_ONLY=true ;;
  esac
done

# -- setup ---------------------------------------------------------------

PROTOC="$SERVER_BUILD_DIR/protoc"

source "$ROOT_DIR/scripts/common"
install_protoc "$SERVER_BUILD_DIR"

if [ ! -x "$PROTOC_GEN_TS" ]; then
  echo "Installing protoc-gen-ts..."
  (cd "$PROJECT_DIR" && bun i)
fi
if [ ! -x "$TSC" ]; then
  echo "Installing the UI's TypeScript..."
  (cd "$ROOT_DIR/ui" && bun i)
fi

echo "Building protoc-gen-kaja..."
mkdir -p "$SERVER_BUILD_DIR"
(cd "$PROJECT_DIR" && go build -o "$PROTOC_GEN_KAJA" .)

# -- test loop ------------------------------------------------------------

rm -rf "$RESULTS_DIR"
mkdir -p "$RESULTS_DIR"

WORKSPACE_DIR="$ROOT_DIR/workspace"

# A test passes when what Kaja generates is what the runtime would have read off
# protoc-gen-ts's output (scripts/compare.ts), and when everything it writes as
# TypeScript - the editor's modules and the plain ones - type-checks. protoc-gen-ts is
# the reference for the field descriptors and nothing else: the declarations are
# Kaja's own. Each test writes $RESULTS_DIR/$test_name/result.txt, PASS or FAIL, and
# on a failure failure.txt beside it.
run_test() {
  local test_name="$1"
  local test_dir="${2%/}"
  local result_dir="$RESULTS_DIR/$test_name"
  local result_file="$result_dir/result.txt"
  local failure_file="$result_dir/failure.txt"

  mkdir -p "$result_dir/expected" "$result_dir/manifest" "$result_dir/typescript"

  proto_files=$(find "$test_dir" -name "*.proto" | sort)
  if [ -z "$proto_files" ]; then
    echo "PASS" > "$result_file"
    return
  fi
  proto_basenames=""
  for f in $proto_files; do
    proto_basenames="$proto_basenames ${f#$test_dir/}"
  done

  ts_ok=true
  (cd "$test_dir" && "$PROTOC" \
    --plugin="protoc-gen-ts=$PROTOC_GEN_TS" \
    --ts_out="$result_dir/expected" \
    --ts_opt=long_type_string \
    --ts_opt=force_optimize_code_size \
    -I. \
    $proto_basenames) 2>"$result_dir/ts_error.txt" || ts_ok=false

  kaja_ok=true
  (cd "$test_dir" && "$PROTOC" \
    --plugin="protoc-gen-kaja=$PROTOC_GEN_KAJA" \
    --kaja_out="$result_dir/manifest" \
    --kaja_opt=kaja_manifest \
    -I. \
    $proto_basenames && "$PROTOC" \
    --plugin="protoc-gen-kaja=$PROTOC_GEN_KAJA" \
    --kaja_out="$result_dir/typescript" \
    -I. \
    $proto_basenames) 2>"$result_dir/kaja_error.txt" || kaja_ok=false

  # protoc refusing the protos is a verdict on the test, not on either plugin.
  if [ "$kaja_ok" = false ]; then
    if [ "$ts_ok" = false ]; then
      echo "PASS" > "$result_file"
    else
      echo "FAIL" > "$result_file"
      { echo "protoc-gen-kaja failed where protoc-gen-ts succeeded"; cat "$result_dir/kaja_error.txt"; } > "$failure_file"
    fi
    return
  fi
  # protoc-gen-ts crashing on what Kaja handled leaves nothing to compare against.
  if [ "$ts_ok" = false ]; then
    rm -rf "$result_dir/expected"
  fi

  if ! (cd "$PROJECT_DIR" && bun scripts/compare.ts "$result_dir") > "$failure_file" 2>&1; then
    echo "FAIL" > "$result_file"
    return
  fi
  # Two fields whose names camel-case alike are one property twice, which no
  # TypeScript can declare; protoc-gen-ts writes the same two lines.
  "$TSC" -p "$result_dir/tsconfig.json" 2>&1 | grep -v -e "error TS2300: Duplicate identifier" -e "error TS2717: Subsequent property declarations" > "$failure_file" || true
  if [ -s "$failure_file" ]; then
    echo "FAIL" > "$result_file"
    return
  fi
  rm -f "$failure_file"
  echo "PASS" > "$result_file"
}

PIDS=()
TEST_NAMES=()

for test_dir in "$TESTS_DIR"/*/; do
  if [ -d "$test_dir" ]; then
    test_name="$(basename "$test_dir")"
    run_test "$test_name" "$test_dir" &
    PIDS+=($!)
    TEST_NAMES+=("$test_name")
  fi
done

for project in grpcbin quirks teams users; do
  proto_dir="$WORKSPACE_DIR/$project/proto"
  if [ -d "$proto_dir" ]; then
    run_test "$project" "$proto_dir" &
    PIDS+=($!)
    TEST_NAMES+=("$project")
  fi
done

wait "${PIDS[@]}"

# -- collect results ------------------------------------------------------

PASS=0
FAIL=0
FAILED=()

for test_name in "${TEST_NAMES[@]}"; do
  result_file="$RESULTS_DIR/$test_name/result.txt"
  failure_file="$RESULTS_DIR/$test_name/failure.txt"
  [ -f "$result_file" ] || continue
  read -r status < "$result_file"
  if [ "$status" = "PASS" ]; then
    PASS=$((PASS + 1))
    [ "$SUMMARY_ONLY" = true ] || echo "PASS $test_name"
  else
    FAIL=$((FAIL + 1))
    FAILED+=("$test_name")
    if [ "$SUMMARY_ONLY" = false ]; then
      echo "FAIL $test_name"
      [ -f "$failure_file" ] && head -40 "$failure_file" && echo ""
    fi
  fi
done

TOTAL=$((PASS + FAIL))
echo ""
echo "Results: $PASS/$TOTAL passed, $FAIL/$TOTAL failed"

if [ "$FAIL" -gt 0 ]; then
  if [ "$SUMMARY_ONLY" = true ]; then
    echo ""
    echo "Failing tests:"
    printf '  %s\n' "${FAILED[@]}"
  fi
  exit 1
fi
