#!/bin/bash
# Runs the desktop app in development: `wails3 dev` watches the Go, rebuilds the
# bundle and restarts it; esbuild's own watcher keeps the UI live and a
# development build reads it off disk, so a UI change is ⌘R rather than a
# rebuild. Everything either of them runs is a task in desktop/Taskfile.yml,
# named by the `executes` in desktop/build/config.yml.
set -e

source "$(dirname "$0")/common"

# Check if Bun is installed (the UI is bundled with it)
if ! command -v bun &> /dev/null
then
    if [ -t 0 ]; then
        echo "Bun is not installed."
        read -p "Would you like to install Bun using Homebrew? (y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Bun installation skipped. Exiting script."
            exit 1
        fi
    fi
    echo "Installing Bun using Homebrew..."
    brew install oven-sh/bun/bun
fi

cd "$(dirname "$0")/.."

export GOBIN=$PWD/server/build
export PATH=$GOBIN:$PATH

# A development bundle runs from build/bin and has no path back to the tree it
# was built in, so it is told where the UI the watcher is writing lives.
export KAJA_FRONTEND_DIR=$PWD/desktop/frontend/dist

# The version desktop/go.mod names, so the CLI that generates the committed
# bindings is the one the app is built against.
install_go_tool github.com/wailsapp/wails/v3/cmd/wails3 \
    "$(module_version github.com/wailsapp/wails/v3 desktop)"

cd ./desktop
wails3 dev -config ./build/config.yml
