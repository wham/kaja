#!/bin/bash
set -e

source "$(dirname "$0")/common"

# Check if Go is installed, if not ask for user confirmation to install it using Homebrew
if ! command -v go &> /dev/null
then
    echo "Go is not installed."
    read -p "Would you like to install Go using Homebrew? (y/n) " -n 1 -r
    echo    # Move to a new line
    if [[ $REPLY =~ ^[Yy]$ ]]
    then
        echo "Installing Go using Homebrew..."
        brew install go
    else
        echo "Go installation skipped. Exiting script."
        exit 1
    fi
fi

# Check if Bun is installed, if not ask for user confirmation to install it using Homebrew
if ! command -v bun &> /dev/null
then
    echo "Bun is not installed."
    read -p "Would you like to install Bun using Homebrew? (y/n) " -n 1 -r
    echo    # Move to a new line
    if [[ $REPLY =~ ^[Yy]$ ]]
    then
        echo "Installing Bun using Homebrew..."
        brew install oven-sh/bun/bun
    else
        echo "Bun installation skipped. Exiting script."
        exit 1
    fi
fi

cd "$(dirname "$0")/.."

# Kill any existing server on port 41520
lsof -ti:41520 | xargs kill 2>/dev/null || true

export GOBIN=$PWD/server/build
export PATH=$GOBIN:$PATH

# Install the code generators to server/build. Their versions come from
# server/go.mod, so each is installed once and then found, rather than resolved
# against the module proxy on every start.
PROTOC_GEN_GO_VERSION=$(module_version google.golang.org/protobuf)
PROTOC_GEN_GO_GRPC_VERSION=$(module_version google.golang.org/grpc/cmd/protoc-gen-go-grpc)

install_protoc
install_go_tool google.golang.org/protobuf/cmd/protoc-gen-go "$PROTOC_GEN_GO_VERSION"
install_go_tool google.golang.org/grpc/cmd/protoc-gen-go-grpc "$PROTOC_GEN_GO_GRPC_VERSION"

# Build protoc-gen-kaja
go build -C protoc-gen-kaja -o $PWD/server/build/protoc-gen-kaja .

# Everything protoc writes is committed, so regenerating it when neither the
# protos nor a generator has moved rewrites the files it already found. The
# generators are what the stamp is taken over, protoc-gen-kaja by its binary
# because it is the one built from sources in this repository.
CODEGEN_STAMP=server/build/.codegen.stamp
CODEGEN=$(fingerprint \
    "$(module_version github.com/wham/protoc-go)" \
    "$PROTOC_GEN_GO_VERSION" \
    "$PROTOC_GEN_GO_GRPC_VERSION" \
    server/build/protoc-gen-kaja \
    $(find server/proto -iname "*.proto" | sort))

if ! stamp_matches "$CODEGEN_STAMP" "$CODEGEN" || [ ! -f ui/src/server/api.ts ] || [ ! -f server/pkg/api/api.pb.go ]; then
    echo "Generating proto client code..."
    # UI proto client code, using protoc-gen-kaja
    protoc --plugin=protoc-gen-kaja=server/build/protoc-gen-kaja --kaja_out=ui/src/server --proto_path=server/proto api.proto
    # require_unimplemented_servers=false so ApiServer is the methods and nothing else:
    # an embedded Unimplemented struct would let a method missing from ApiService compile.
    (cd server && protoc --proto_path=. --plugin=protoc-gen-go=./build/protoc-gen-go --go_out=. --plugin=protoc-gen-go-grpc=./build/protoc-gen-go-grpc --go-grpc_out=. --go-grpc_opt=require_unimplemented_servers=false -Iproto/ $(find proto -iname "*.proto"))
    stamp_write "$CODEGEN_STAMP" "$CODEGEN"
fi

cd "./ui"
bun i

# The UI bundle is not built here: this server is built with -tags development,
# where it bundles the UI itself on the first request for it and again after
# every edit. Building it up front would only be building it twice.

cd ../server
mkdir -p /tmp/kaja
GIT_REF=$(git rev-parse HEAD 2>/dev/null || echo "")
go build -tags development -ldflags "-X main.GitRef=$GIT_REF" -o /tmp/kaja/kaja ./cmd/server
# Pass --editable to let the UI write to workspace/kaja.json.
/tmp/kaja/kaja "$@"
